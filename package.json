{
  "name": "verifyanyemail-mcp",
  "version": "1.2.0",
  "description": "Model Context Protocol (MCP) server for VerifyAnyEmail — real-time email verification and deliverability diagnostics for AI agents (Claude, ChatGPT, Cursor, and any MCP client).",
  "license": "MIT",
  "author": "VerifyAnyEmail",
  "homepage": "https://verifyany.email",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verifyanyemail/verifyanyemail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/verifyanyemail/verifyanyemail-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "email",
    "verification",
    "deliverability",
    "ai",
    "agents",
    "claude",
    "chatgpt",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "verifyanyemail-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts src/http.ts --format esm --clean --target node18 --sourcemap",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "verifyanyemail": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
